# Copy to .env and fill server-only credentials. Do not overwrite an existing .env.
GOALSIFT_LLM_PROVIDER=deepseek
GOALSIFT_LLM_MODEL=deepseek-flash
GOALSIFT_LLM_API_KEY=
GOALSIFT_SEARCH_PROVIDER=exa
GOALSIFT_SEARCH_API_KEY=
# Blank uses .goalsift_data under the project. Tests always use isolated roots.
GOALSIFT_DATA_DIR=
# Hard limits per research revision; resume retains prior usage.
# Refine creates a new revision and therefore a new budget.
GOALSIFT_MAX_ACTIONS=30
GOALSIFT_MAX_TOOL_CALLS=20
GOALSIFT_MAX_RUNTIME_SECONDS=300
GOALSIFT_BUDGET_USD=0.20
GOALSIFT_MAX_SEARCH_ROUNDS=3
GOALSIFT_REQUEST_TIMEOUT_SECONDS=60
GOALSIFT_MAX_MODEL_INPUT_TOKENS=50000
GOALSIFT_MAX_MODEL_OUTPUT_TOKENS=5000
# Optional current model prices; both required for models outside the known price table.
# GOALSIFT_LLM_INPUT_USD_PER_MILLION=
# GOALSIFT_LLM_OUTPUT_USD_PER_MILLION=
# An empty BUDGET_USD removes the spend cap; calls still incur provider charges.
