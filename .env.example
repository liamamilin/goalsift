# GoalSift configuration template.
# Copy to `.env` and fill real values. `.env` is gitignored and never committed.
# M0 does not require any of these; M1 live tests need LLM + search credentials
# or those live tests will be reported as BLOCKED (not faked PASS).

# --- LLM provider (M1 Spike requires authorized key for live model calls) ---
GOALSIFT_LLM_PROVIDER=          # e.g. openai, anthropic, deepseek, ...
GOALSIFT_LLM_API_KEY=
GOALSIFT_LLM_MODEL=             # e.g. gpt-4o-mini, claude-3-5-sonnet, ...

# --- Search / fetch provider (M1 Spike requires authorized key for live search) ---
GOALSIFT_SEARCH_PROVIDER=       # e.g. tavily, exa, firecrawl, ...
GOALSIFT_SEARCH_API_KEY=

# --- App isolated data root ---
# Default (dev): ./.goalsift_data  (gitignored, app-only)
# Tests force an isolated temp dir; production may point at a user-local dir.
GOALSIFT_DATA_DIR=

# --- Execution budget (enforced hard limits by backend, not prompt) ---
GOALSIFT_MAX_ACTIONS=           # max research actions per run
GOALSIFT_MAX_TOOL_CALLS=        # max external tool calls per run
GOALSIFT_MAX_RUNTIME_SECONDS=   # wall-clock cap per run
GOALSIFT_BUDGET_USD=            # max spend per run; blank => unknown cost, no charge
